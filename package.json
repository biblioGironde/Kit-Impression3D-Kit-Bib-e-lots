{
  "name": "kit-impression3d-atelier-dagoma-neva",
  "productName": "Atelier Impression 3D",
  "version": "2.2.1",
  "description": "Kit bib-e-lots - Atelier Impression 3D : préparer et lancer une impression 3D sur Dagoma Neva, Anycubic Vyper ou Ultimaker S7, sans connaître le slicing.",
  "author": "biblio.gironde",
  "homepage": "https://github.com/biblioGironde/Kit-Impression3D-Atelier-Dagoma-Neva",
  "repository": {
    "type": "git",
    "url": "https://github.com/biblioGironde/Kit-Impression3D-Atelier-Dagoma-Neva.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "build:web": "python3 build.py",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.gironde.biblio.atelier-neva",
    "productName": "Atelier Impression 3D",
    "artifactName": "Atelier-Impression3D-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "vendor/**",
      "modeles/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Atelier-Impression3D-${version}-windows-installation.${ext}"
    },
    "portable": {
      "artifactName": "Atelier-Impression3D-${version}-windows-portable.${ext}"
    },
    "linux": {
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
